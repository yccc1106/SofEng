# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# test reports
/coverage

# next.js
/.next/
/out/

# build outputs
/build
**/target/
/backend/uploads/
/uploads/

# Java runtime artifacts
*.class
hs_err_pid*

# misc
.DS_Store
._*
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local environment and secret files
.env*
!.env.example
/backend/src/main/resources/application-local.yml
/backend/src/main/resources/application-*.local.yml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE and local agent settings
/.idea/
/.vscode/
*.iml
/.claude/settings.local.json
