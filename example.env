JAVA_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_JAVA_WS_URL=ws://localhost:8080/api/chat/ws

# TRTC voice/video calls (server-side secret, never expose to the browser)
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
TRTC_USER_SIG_EXPIRE_SECONDS=86400

# DeepSeek intent parsing (server-side)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local chat image storage
UPLOAD_DIR=./uploads
